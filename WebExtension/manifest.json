{
  "manifest_version": 2,
  "name": "Page Helper",
  "version": "0.3.8",
  "description": "Перевод страницы через собственный ChatGPT Plus с заменой оригинала.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "scripts": [
      "text-stream.js",
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Page Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "paper.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}